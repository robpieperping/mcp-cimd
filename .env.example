# PingOne OIDC client used for the client_credentials flow.
PINGONE_ENV_ID=your-pingone-environment-id
PINGONE_CLIENT_ID=your-pingone-client-id
PINGONE_CLIENT_SECRET=your-pingone-client-secret

# Base URL of the FHIR R4 server, including the /fhir path.
FHIR_BASE_URL=https://your-fhir-server.example.com/fhir
