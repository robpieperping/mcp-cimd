# ── Inbound: what ChatGPT's token must satisfy ────────────────────────────────
# These govern this server's role as an OAuth 2.1 protected resource. They are
# required whenever MCP_TRANSPORT=http and MCP_AUTH is not "disabled".

# The canonical https identifier for this MCP server. Exact-matched against
# the token's `aud`, advertised as `resource` in protected-resource metadata,
# and what the client sends as the RFC 8707 `resource` parameter. No trailing
# slash, no fragment -- all three values have to be the same string.
MCP_RESOURCE=https://mcp-cimd.ping-devops.com/mcp

# PingFederate's issuer, exactly as its openid-configuration reports it.
OAUTH_ISSUER=https://facile-pastrami-lipogram.ping-devops.com

# Defaults to $OAUTH_ISSUER/pf/JWKS, which is where PingFederate publishes
# keys. Set it explicitly for any other authorization server.
#OAUTH_JWKS_URI=https://facile-pastrami-lipogram.ping-devops.com/pf/JWKS

# Scopes. OAUTH_READ_SCOPE is required on every request; OAUTH_WRITE_SCOPE is
# additionally required by the mutating tools (see src/tool-access.ts).
#OAUTH_READ_SCOPE=fhir.read
#OAUTH_WRITE_SCOPE=fhir.write

# Advertised in scopes_supported. Every scope listed here must be grantable in
# PingFederate, or linking fails at the consent screen. Defaults to the read
# scope alone, which is the minimal set for basic functionality.
#OAUTH_SCOPES_SUPPORTED=fhir.read

# Which tools are exposed. "read" (the default) hides the six mutating tools
# outright; "all" exposes them, still gated on OAUTH_WRITE_SCOPE.
#MCP_TOOLSET=read

# "disabled" turns off inbound token validation. Local development only: it
# serves patient data to anyone who can reach the port.
#MCP_AUTH=required

#OAUTH_CLOCK_SKEW_SECONDS=60
#OAUTH_JWKS_CACHE_SECONDS=300

# ── Transport ────────────────────────────────────────────────────────────────
# "stdio" (the default) for an MCP host; "http" for the cluster and ChatGPT.
#MCP_TRANSPORT=stdio
#PORT=3000
#HOST=0.0.0.0

# ── Outbound: this server's own call to FHIR ──────────────────────────────────

# Base URL of the FHIR R4 server, including the /fhir path.
FHIR_BASE_URL=https://your-fhir-server.example.com/fhir

# Optional. A PingOne client_credentials app for the upstream FHIR call. With
# these unset the FHIR hop goes out unauthenticated -- see the README section
# "The upstream FHIR hop is unauthenticated", which is a known gap, not a
# surprise.
#PINGONE_ENV_ID=
#PINGONE_CLIENT_ID=
#PINGONE_CLIENT_SECRET=
