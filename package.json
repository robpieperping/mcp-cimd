{
  "name": "mcp-cimd",
  "version": "1.0.0",
  "description": "FHIR MCP server that is its own OAuth 2.1 protected resource, for ChatGPT via PingFederate CIMD",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:http": "MCP_TRANSPORT=http ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch",
    "test": "npm run build && node --test test/auth.test.mjs test/jwks-resilience.test.mjs test/test-client-doc.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.7.0",
    "express": "^5.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
